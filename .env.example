# Copy to .env and adjust. The server reads these at startup.
PORT=4000

# Supabase (server-side)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_ANON_KEY=

# Optional: JWT audience check (default: authenticated)
CRM_JWT_AUDIENCE=authenticated

# CRM frontend (Vite) — expose only the anon key, never the service role key
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# CRM idle timeout in ms (default 30 minutes if unset)
VITE_CRM_IDLE_TIMEOUT_MS=

# Dev-only: bake in CRM auth self-test route for `npm run test:crm-visibility`
# Never set to 1 in production builds.
VITE_CRM_AUTH_SELF_TEST=

# Customer-service assistant (Google Gemini — https://aistudio.google.com/apikey).
# The key stays server-side; the browser only ever talks to /api/assistant.
GEMINI_API_KEY=
# Optional overrides. New Gemini keys cannot use 2.5; keep 3.x stable IDs.
GEMINI_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
ASSISTANT_CONTACT_EMAIL=support.IJTechnology@gmail.com

# Email notifications for new contact submissions (Resend — https://resend.com).
# Leave RESEND_API_KEY blank to disable email; submissions still save to the DB.
RESEND_API_KEY=
CONTACT_NOTIFY_TO=          # where new-lead emails are sent (your inbox)
# "From" address. The default only delivers to your own Resend account email;
# set a verified-domain sender once you have one, e.g. "IJ Technologys <hello@yourdomain.com>".
CONTACT_FROM=IJ Technologys <onboarding@resend.dev>
