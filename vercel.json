{
  "version": 2,
  "installCommand": "npm install && npm install --prefix apps/crm --include=dev",
  "buildCommand": "npm run build:crm",
  "builds": [
    {
      "src": "api/index.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": "apps/crm/dist/**"
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/api/index.js" }
  ]
}
